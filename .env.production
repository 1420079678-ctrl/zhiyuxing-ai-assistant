# =======================================================
# ZhiYuXing AI Copilot - Enterprise Production Environment
# =======================================================

# Server Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Security & Multi-tenant API Auth (Set to true in production)
API_KEY_AUTH_ENABLED=false
API_MASTER_KEYS=zyx-live-master-secret-key-prod,zyx-tenant-enterprise-demo

# Model Provider Configurations (OpenAI / DeepSeek / OrcaRouter)
MODEL_PROVIDER=DeepSeek
MODEL_NAME=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# Optional OrcaRouter Gateway configuration (Uncomment to use OrcaRouter)
# OPENAI_BASE_URL=https://api.orcarouter.ai/v1
# MODEL_NAME=openai/gpt-4o-mini
# MODEL_PROVIDER=OrcaRouter
# ORCAROUTER_API_KEY=

# Model Generation Hyperparameters
MODEL_TEMPERATURE=0.7

# Operational Mode (false for live enterprise model calls)
DEMO_MODE=false
PUBLIC_DEMO_MODE=false

# Data Persistence & Connection Pool
CHAT_DB_PATH=/app/data/zhiyuxing.db
SQLITE_BUSY_TIMEOUT_MS=5000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=*
